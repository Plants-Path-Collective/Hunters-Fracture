  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: UI_Items_es-CL
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: es-CL
  m_SharedData: {fileID: 11400000, guid: 958935858e1cad9ad9b44b6f088553bb, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 22753544720384
    m_Localized: "Com\xFAn"
    m_Metadata:
      m_Items: []
  - m_Id: 22753544720385
    m_Localized: Raro
    m_Metadata:
      m_Items: []
  - m_Id: 881679618048
    m_Localized: Revista Aniki
    m_Metadata:
      m_Items: []
  - m_Id: 950298431488
    m_Localized: "Cuando el portador recibe un ataque, tiene 5% de probabilidad de
      aumentar su defensa m\xE1gica un 5\u201310% (+5% por copia) hasta el final
      del combate, seg\xFAn la vida que le falte."
    m_Metadata:
      m_Items: []
  - m_Id: 22753548914688
    m_Localized: Completo Italiano
    m_Metadata:
      m_Items: []
  - m_Id: 22753548914689
    m_Localized: El portador aumenta su vida en 15 (+5 por copia) por cada 10 de
      fuerza.
    m_Metadata:
      m_Items: []
  - m_Id: 22753548914690
    m_Localized: "Sombrero de Cumplea\xF1ero"
    m_Metadata:
      m_Items: []
  - m_Id: 22753548914691
    m_Localized: "Cuando el portador ataca, roba un 10% (+5% por copia) del poder
      m\xE1gico del objetivo durante el resto del combate."
    m_Metadata:
      m_Items: []
  - m_Id: 22753548914692
    m_Localized: "Mu\xF1eca de Porcelana"
    m_Metadata:
      m_Items: []
  - m_Id: 22753548914693
    m_Localized: "El portador aumenta su fuerza un 25% (+10% por copia), pero reduce
      su defensa f\xEDsica y m\xE1gica en un 15% (+10% por copia)."
    m_Metadata:
      m_Items: []
  - m_Id: 22753548914694
    m_Localized: Collar de Piedra Luna
    m_Metadata:
      m_Items: []
  - m_Id: 22753548914695
    m_Localized: "Una vez por combate, cuando la vida del portador cae por debajo
      del 30%, recupera un 20% (+10% por copia) de su vida y consume un 50% (+10%
      por copia) de su energ\xEDa actual."
    m_Metadata:
      m_Items: []
  - m_Id: 22753548914696
    m_Localized: "Olla a Presi\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 22753548914697
    m_Localized: "El portador aumenta su defensa f\xEDsica un 30%. Cuando recibe
      un ataque, tiene 10% de probabilidad de quedar aturdido y perder su pr\xF3ximo
      turno."
    m_Metadata:
      m_Items: []
  - m_Id: 22753548914698
    m_Localized: Bolsa con Pescado
    m_Metadata:
      m_Items: []
  - m_Id: 22753548914699
    m_Localized: "Cuando el portador impacta con un ataque b\xE1sico o una t\xE9cnica,
      tiene 10% de probabilidad de reducir la velocidad del objetivo en un 5% (+1.5%
      por copia)."
    m_Metadata:
      m_Items: []
  - m_Id: 22753553108992
    m_Localized: "Billete fuera de Circulaci\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 22753553108993
    m_Localized: "El portador reduce en un 10% (+3% por copia) el costo de energ\xEDa
      de sus t\xE9cnicas. Adem\xE1s, aumenta la probabilidad de que los enemigos
      lo ataquen."
    m_Metadata:
      m_Items: []
  - m_Id: 22753553108994
    m_Localized: PVC de 3 puntas
    m_Metadata:
      m_Items: []
  - m_Id: 22753553108995
    m_Localized: "El portador reemplaza su ataque b\xE1sico por un ataque m\xFAltiple:
      golpea al objetivo y a un combatiente aleatorio pr\xF3ximo a \xE9l. El da\xF1o
      del ataque se reduce a un 66% (+10% por copia)."
    m_Metadata:
      m_Items: []
  - m_Id: 22753553108996
    m_Localized: Cerveza de Sal
    m_Metadata:
      m_Items: []
  - m_Id: 22753553108997
    m_Localized: "Cuando el portador usa una t\xE9cnica con objetivo enemigo, tiene
      20% (+20% por copia) de probabilidad de que golpee a todos los enemigos y tambi\xE9n
      a una unidad aleatoria adyacente al portador."
    m_Metadata:
      m_Items: []
  - m_Id: 22753553108998
    m_Localized: Corta Zapallo
    m_Metadata:
      m_Items: []
  - m_Id: 22753553108999
    m_Localized: "Cuando el portador impacta con un ataque b\xE1sico o una t\xE9cnica,
      reduce la defensa f\xEDsica del objetivo un 10% por impacto y le aplica 1 acumulaci\xF3n
      de hemorragia. Cada acumulaci\xF3n (20 m\xE1x.) inflige 10 de da\xF1o por turno
      y reduce la velocidad del objetivo en un 5% hasta el final del combate."
    m_Metadata:
      m_Items: []
  - m_Id: 22753553109000
    m_Localized: Reproductor de CD
    m_Metadata:
      m_Items: []
  - m_Id: 22753553109001
    m_Localized: "Cuando el portador ataca o usa una t\xE9cnica, tiene 10% (+5% por
      copia) de probabilidad de repetir su turno inmediatamente."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
